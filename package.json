{
  "name": "@jiuai233/pi-prompt-suggestions",
  "version": "1.3.2",
  "type": "module",
  "description": "Predict the next user message with an independent model and optional ghost text for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-suggestions"
  ],
  "files": [
    "plugin/",
    "skills/",
    "scripts/",
    "examples/",
    "host-reference/",
    "AGENT-HANDOFF.md",
    "SOURCE.json",
    "FILES.json",
    "VERIFICATION.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./plugin/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test plugin/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --project plugin/tsconfig.json"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typescript": "5.9.3",
    "@types/node": "25.5.0"
  },
  "license": "MIT",
  "author": {
    "name": "syansunyang-collab",
    "url": "https://github.com/syansunyang-collab"
  },
  "contributors": [
    {
      "name": "jiuai233",
      "url": "https://github.com/jiuai233"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiuai233/pi-prompt-suggestions.git"
  },
  "homepage": "https://github.com/jiuai233/pi-prompt-suggestions#readme",
  "bugs": {
    "url": "https://github.com/jiuai233/pi-prompt-suggestions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
