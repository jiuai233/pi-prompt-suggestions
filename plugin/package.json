{
  "name": "@pi-stack/prompt-suggestions",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "Shared next-prompt generation and terminal ghost suggestions for Pi",
  "exports": {
    ".": {
      "types": "./api.d.mts",
      "import": "./api.mjs"
    },
    "./core": {
      "types": "./core.d.mts",
      "import": "./core.mjs"
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test *.test.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "license": "MIT"
}
